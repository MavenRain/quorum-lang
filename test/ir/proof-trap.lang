evidence : ℕ → 0 ≡ 0
evidence n = flagIf (natEq (natAdd n 1) 0) refl refl
transport : (P : ℕ → Type) → (x : ℕ) → (y : ℕ) → x ≡ y → P x → P y
transport P x y p u = primTransp (λ i → P (p i)) i0 u
sym : (x : ℕ) → (y : ℕ) → x ≡ y → y ≡ x
sym x y p i = p (~ i)
trans : (x : ℕ) → (y : ℕ) → (z : ℕ) → x ≡ y → y ≡ z → x ≡ z
trans x y z p q i = primHComp (λ j → λ { (i = i0) → x ; (i = i1) → q j }) (p i)
cong : (f : ℕ → ℕ) → (x : ℕ) → (y : ℕ) → x ≡ y → f x ≡ f y
cong f x y p i = f (p i)
proofMove : ℕ → ℕ
proofMove n = transport (λ (x : ℕ) → ℕ) 0 0 (evidence n) 7
proofSymm : ℕ → ℕ
proofSymm n = transport (λ (x : ℕ) → ℕ) 0 0 (sym 0 0 (evidence n)) 7
baseProof : 0 ≡ 0
baseProof = refl
proofTrans : ℕ → ℕ
proofTrans n = transport (λ (x : ℕ) → ℕ) 0 0 (trans 0 0 0 baseProof (evidence n)) 7
proofCong : ℕ → ℕ
proofCong n = transport (λ (x : ℕ) → ℕ) 0 0 (cong (λ (x : ℕ) → x) 0 0 (evidence n)) 7
