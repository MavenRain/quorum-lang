-- Formers F5 and F8: pure, map and bind over Maybe. filter is a guest definition.
lifted : Maybe ℕ
lifted = map (λ (n : ℕ) → natAdd n 1) (just 4)
chained : Maybe ℕ
chained = bind (just 4) (λ (n : ℕ) → just (natMul n 2))
wrapped : Maybe ℕ
wrapped = pure 5
-- The core has no filter. This is the derived form.
filter : (ℕ → Bool) → Maybe ℕ → Maybe ℕ
filter p m = bind m (λ (x : ℕ) → flagIf (p x) (just x) nothing)
kept : Maybe ℕ
kept = filter (λ (n : ℕ) → natEq n 4) (just 4)
dropped : Maybe ℕ
dropped = filter (λ (n : ℕ) → natEq n 4) (just 5)
