-- The sample domain in use, with the indexed data type Lot (former F15).
bolt : Item
bolt = makeItem red 3 10
nut : Item
nut = makeItem blue 1 40
stock : Stack
stock = push (lineTotal bolt) (push (lineTotal nut) bottom)
stockTotal : ℕ
stockTotal = fold 0 (λ (top : ℕ) (acc : ℕ) → natAdd top acc) stock
boltRed : Bool
boltRed = isRed (itemColor bolt)
pile : Stack
pile = push 1 (push 2 bottom)
pileDepth : ℕ
pileDepth = depth pile
lot : Lot 3
lot = makeLot 3 250
lotCost : ℕ
lotCost = lotPrice lot
