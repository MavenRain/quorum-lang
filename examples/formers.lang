-- Formers F1 and F3: products and Maybe. S1 refuses Sum (F2) and List (F4).
price : ℕ
price = 1200
both : ℕ × Bool
both = pair price true
left : ℕ
left = first both
right : Bool
right = second both
absent : Maybe ℕ
absent = nothing
present : Maybe ℕ
present = just 7
orZero : Maybe ℕ → ℕ
orZero o = option 0 (λ (n : ℕ) → n) o
