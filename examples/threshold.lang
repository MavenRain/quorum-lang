  fork-u : (σ : State) → (a : State) → (b : State) → Authorized σ b → Signed σ a → a ≡ b
  fork-u σ a b y u = rec₁ (Signed σ b) (a ≡ b) (isSetState a b) (fork-v σ a b u) y
  law no-fork : (σ : State) → (a : State) → (b : State) → Authorized σ a → Authorized σ b → a ≡ b
  no-fork σ a b x y = rec₁ (Signed σ a) (a ≡ b) (isSetState a b) (fork-u σ a b y) x
  Desc : State → ℕ → State → Type
