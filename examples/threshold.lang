  legit-step ρ σ l a = rec₁ (ReachA ρ) (LegitA σ) (squash (ReachA σ)) (legit-snoc ρ σ a) l
  desc-legit : (n : ℕ) → (σ : State) → Desc genesis n σ → LegitA σ
