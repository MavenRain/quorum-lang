-- The toy instance of the section Authority. Each member is in each quorum
-- (toyIn) and is honest, and a member endorses only the successor of a
-- state. So two quorums meet, each endorsed step is a real step, and no
-- member endorses two successors of one state.
toyHonest : Bool → Type
toyHonest i = i ≡ i

toyEndorses : Bool → ℕ → ℕ → Type
toyEndorses i σ τ = suc σ ≡ τ

toyHonestMeet : (c : Bool) → (q : Bool) → (r : Bool) → ∃[ i ꞉ Bool ] toyIn c i q × toyIn c i r × toyHonest i
toyHonestMeet c q r = ∣_∣₁ (Σ Bool (λ i → toyIn c i q × toyIn c i r × toyHonest i)) (true , refl , refl , refl)

