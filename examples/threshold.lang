-- The S4 design file (PLAN sec 9 S4 row): design/ThresholdVC/Design.agda
-- secs 1 to 6 at the denotation, then a closed toy instance. The Claude
-- readings (PLAN sec 10, not ruled):
-- O57: Reach is a chain of n steps from genesis, made by a large elim on ℕ.
-- A data type over the telescope is not a cell signature (rule R1), and S3
-- has no fold over an indexed family (O31). Descent is a chain of the same
-- kind.
-- O58: the section Design has the 22 telescope parameters (secs 2 to 4).
-- The section Authority has the 22 parameters and 5 more (secs 5 and 6).
-- O59: a section holds no record (O35), so Step and Replica are at the top
-- level and take only the parameters that their fields use.
-- O60: there are no imports (O43). This file keeps a copy of the Prelude
-- definitions that it uses, and of NatSet and FMSet from examples/bag.lang.
-- The ℕ comparator is in the section NatSet (O55), so it is not a Wasm entry.
-- O62: `⟦ e ⟧ᵉ` gives NAME_UNKNOWN, so the edit map is `apply` and the
-- meaning map of a replica is `denote`.
-- O63: there are no implicit arguments (O41). Each argument is explicit.
sym : (A : Type) → (x : A) → (y : A) → x ≡ y → y ≡ x
sym A x y p i = p (~ i)

cong : (A : Type) → (B : Type) → (f : A → B) → (x : A) → (y : A) → x ≡ y → f x ≡ f y
cong A B f x y p i = f (p i)

_∙_ : (A : Type) → (x : A) → (y : A) → (z : A) → x ≡ y → y ≡ z → x ≡ z
_∙_ A x y z p q i = primHComp (λ j → λ { (i = i0) → x ; (i = i1) → q j }) (p i)

isProp : Type → Type
isProp A = (x : A) → (y : A) → x ≡ y

isSet : Type → Type
isSet A = (x : A) → (y : A) → (p : x ≡ y) → (q : x ≡ y) → p ≡ q

data ∥_∥₁ (A : Type) : Type where
  ∣_∣₁ : (a : A) → ∥_∥₁ A
  squash₁ : (x : ∥ A ∥₁) → (y : ∥ A ∥₁) → x ≡ y

rec₁ : (A : Type) → (B : Type) → isProp B → (A → B) → ∥ A ∥₁ → B
rec₁ A B pr f x = fold f pr x

∃ : (A : Type) → (A → Type) → Type
∃ A B = ∥ Σ A (λ x → B x) ∥₁

squash : (A : Type) → isProp ∥ A ∥₁
squash A x y = squash₁ A x y

absurd : false ≡ true → (C : Type) → C
absurd p C = primTransp (λ i → elim (λ (b : Bool) → Type) C ℕ (p i)) i0 0

Sound : (A : Type) → (A → A → Bool) → Type
Sound A eq = (x : A) → (y : A) → eq x y ≡ true → x ≡ y

Reflexive : (A : Type) → (A → A → Bool) → Type
Reflexive A eq = (x : A) → eq x x ≡ true

collapseAt : (A : Type) → (eq : A → A → Bool) → Sound A eq → Reflexive A eq → (a : A) → (x : A) → a ≡ x → (c : Bool) → eq a x ≡ c → a ≡ x
collapseAt A eq sound rfl a x p c h = elim (λ (d : Bool) → eq a x ≡ d → a ≡ x) (λ (g : eq a x ≡ true) → sound a x g) (λ (g : eq a x ≡ false) → p) c h

collapse : (A : Type) → (eq : A → A → Bool) → Sound A eq → Reflexive A eq → (a : A) → (x : A) → a ≡ x → a ≡ x
collapse A eq sound rfl a x p = collapseAt A eq sound rfl a x p (eq a x) refl

collapseConst : (A : Type) → (eq : A → A → Bool) → (sound : Sound A eq) → (rfl : Reflexive A eq) → (a : A) → (x : A) → (p : a ≡ x) → (q : a ≡ x) → collapse A eq sound rfl a x p ≡ collapse A eq sound rfl a x q
collapseConst A eq sound rfl a x p q = elim (λ (c : Bool) → (h : eq a x ≡ c) → collapseAt A eq sound rfl a x p c h ≡ collapseAt A eq sound rfl a x q c h) (λ (h : eq a x ≡ true) → refl) (λ (h : eq a x ≡ false) → absurd (_∙_ Bool false (eq a x) true (sym Bool (eq a x) false h) (_∙_ Bool (eq a x) (eq a a) true (cong A Bool (λ (y : A) → eq a y) x a (sym A a x p)) (rfl a))) (p ≡ q)) (eq a x) refl

discreteIsSet : (A : Type) → (eq : A → A → Bool) → Sound A eq → Reflexive A eq → isSet A
discreteIsSet A eq sound rfl a b p q j i = primHComp (λ k → λ { (i = i0) → collapse A eq sound rfl a a (λ (l : I) → a) k ; (i = i1) → collapseConst A eq sound rfl a b p q j k ; (j = i0) → collapse A eq sound rfl a (p i) (λ (l : I) → p (l ∧ i)) k ; (j = i1) → collapse A eq sound rfl a (q i) (λ (l : I) → q (l ∧ i)) k }) a

module NatSet (X : Type) where
  eqℕ : ℕ → ℕ → Bool
  eqℕ u v = elim (λ (k : ℕ) → ℕ → Bool) (λ (j : ℕ) → elim (λ (i : ℕ) → Bool) true (λ (i : ℕ) (r : Bool) → false) j) (λ (k : ℕ) (ih : ℕ → Bool) (j : ℕ) → elim (λ (i : ℕ) → Bool) false (λ (i : ℕ) (r : Bool) → ih i) j) u v
  reflℕ : (n : ℕ) → eqℕ n n ≡ true
  reflℕ n = elim (λ (k : ℕ) → eqℕ k k ≡ true) refl (λ (k : ℕ) (ih : eqℕ k k ≡ true) → ih) n
  soundℕ : (u : ℕ) → (v : ℕ) → eqℕ u v ≡ true → u ≡ v
  soundℕ u v = elim (λ (k : ℕ) → (j : ℕ) → eqℕ k j ≡ true → k ≡ j) (λ (j : ℕ) → elim (λ (i : ℕ) → eqℕ 0 i ≡ true → 0 ≡ i) (λ (h : eqℕ 0 0 ≡ true) → refl) (λ (i : ℕ) (r : eqℕ 0 i ≡ true → 0 ≡ i) (h : eqℕ 0 (suc i) ≡ true) → absurd h (0 ≡ suc i)) j) (λ (k : ℕ) (ih : (j : ℕ) → eqℕ k j ≡ true → k ≡ j) (j : ℕ) → elim (λ (i : ℕ) → eqℕ (suc k) i ≡ true → suc k ≡ i) (λ (h : eqℕ (suc k) 0 ≡ true) → absurd h (suc k ≡ 0)) (λ (i : ℕ) (r : eqℕ (suc k) i ≡ true → suc k ≡ i) (h : eqℕ (suc k) (suc i) ≡ true) → cong ℕ ℕ (λ (l : ℕ) → suc l) k i (ih i h)) j) u v
  isSetℕ : isSet ℕ
  isSetℕ = discreteIsSet ℕ eqℕ soundℕ reflℕ

data FMSet (A : Type) : Type where
  eta : (el : A) → FMSet A
  [] : FMSet A
  m : (l₁ : FMSet A) → (r₁ : FMSet A) → FMSet A
  munit : (s₂ : FMSet A) → m A ([] A) s₂ ≡ s₂
  massoc : (s₃ : FMSet A) → (t₃ : FMSet A) → (u₃ : FMSet A) → m A (m A s₃ t₃) u₃ ≡ m A s₃ (m A t₃ u₃)
  mcomm : (s₄ : FMSet A) → (t₄ : FMSet A) → m A s₄ t₄ ≡ m A t₄ s₄
  trunc : (s₅ : FMSet A) → (t₅ : FMSet A) → (p₅ : s₅ ≡ t₅) → (q₅ : s₅ ≡ t₅) → p₅ ≡ q₅

-- Sec 3: one governance step (Q2: a record). The rules of the source state
-- choose the edit from a bag of ballots. The step must keep Core.
record Step (State : Type) (Agenda : Type) (Ballot : Type) (Edit : Type) (rules : State → Agenda → FMSet Ballot → Maybe Edit) (apply : Edit → State → State) (Core : State → Type) (σ : State) (τ : State) : Type where
  agenda : Agenda
  bag : FMSet Ballot
  edit : Edit
  chosen : rules σ agenda bag ≡ just edit
  lands : apply edit σ ≡ τ
  keeps : Core σ → Core τ

-- Secs 2 to 4. A Policy is what a constitution means: its input is a bag, so
-- it ignores ballot order. Reach σ is a rooted path of steps (O57), and
-- Legit σ is its truncation: a client knows only that σ descends from
-- genesis. The two laws reach-core and legit-core close sec 4.
module Design (Artifact : Type) (Ballot : Type) (Agenda : Type) (Edit : Type) (Member : Type) (Committee : Type) (Quorum : Committee → Type) (_∈_ : (c : Committee) → Member → Quorum c → Type) (Circuit : Type → Type → Type) (run : (A : Type) → (B : Type) → Circuit A B → A → B) (State : Type) (isSetState : isSet State) (height : State → ℕ) (artifact : State → Artifact) (committee : State → Committee) (constitution : State → Agenda → Circuit (FMSet Ballot) (Maybe Edit)) (apply : Edit → State → State) (advance : (e : Edit) → (σ : State) → height (apply e σ) ≡ suc (height σ)) (genesis : State) (Core : State → Type) (isPropCore : (σ : State) → isProp (Core σ)) (core₀ : Core genesis) where
  Policy : Type
  Policy = Agenda → FMSet Ballot → Maybe Edit
  rules : State → Policy
  rules σ a = run (FMSet Ballot) (Maybe Edit) (constitution σ a)
  StepD : State → State → Type
  StepD σ τ = Step State Agenda Ballot Edit rules apply Core σ τ
  step : (σ : State) → (τ : State) → (a : Agenda) → (b : FMSet Ballot) → (e : Edit) → rules σ a b ≡ just e → apply e σ ≡ τ → (Core σ → Core τ) → StepD σ τ
  step σ τ a b e c l k = a , b , e , c , l , k
  Chain : ℕ → State → Type
  Chain n = elim (λ (k : ℕ) → State → Type) (λ (σ : State) → genesis ≡ σ) (λ (k : ℕ) (ih : State → Type) (σ : State) → Σ State (λ τ → ih τ × StepD τ σ)) n
  Reach : State → Type
  Reach σ = Σ ℕ (λ n → Chain n σ)
  root : Reach genesis
  root = 0 , refl
  _▸_ : (σ : State) → (τ : State) → Reach σ → StepD σ τ → Reach τ
  _▸_ σ τ h s = suc (fst h) , σ , snd h , s
  Legit : State → Type
  Legit σ = ∥ Reach σ ∥₁
  chain-core : (n : ℕ) → (σ : State) → Chain n σ → Core σ
  chain-core n = elim (λ (k : ℕ) → (σ : State) → Chain k σ → Core σ) (λ (σ : State) (p : genesis ≡ σ) → primTransp (λ i → Core (p i)) i0 core₀) (λ (k : ℕ) (ih : (σ : State) → Chain k σ → Core σ) (σ : State) (h : Chain (suc k) σ) → keeps State Agenda Ballot Edit rules apply Core (fst h) σ (snd (snd h)) (ih (fst h) (fst (snd h)))) n
  law reach-core : (σ : State) → Reach σ → Core σ
  reach-core σ h = chain-core (fst h) σ (snd h)
  law legit-core : (σ : State) → Legit σ → Core σ
  legit-core σ = rec₁ (Reach σ) (Core σ) (isPropCore σ) (reach-core σ)

-- Sec 6: a replica (O59). Its meaning is a tip: a state with a certified
-- descent from genesis. The map denote is a join-semilattice morphism, so
-- merge means the join of tips. Le is the descent order of the section
-- Authority.
record Replica (State : Type) (genesis : State) (Le : State → State → Type) : Type₁ where
  Rep : Type
  none : Rep
  merge : Rep → Rep → Rep
  denote : Rep → Σ State (λ σ → Le genesis σ)
  denote-none : fst (denote none) ≡ genesis
  denote-mergeˡ : (r : Rep) → (s : Rep) → Le (fst (denote r)) (fst (denote (merge r s)))
  denote-mergeʳ : (r : Rep) → (s : Rep) → Le (fst (denote s)) (fst (denote (merge r s)))
  denote-mergeᵘ : (r : Rep) → (s : Rep) → (τ : State) → Le (fst (denote r)) τ → Le (fst (denote s)) τ → Le (fst (denote (merge r s))) τ

-- Secs 5 and 6. A certificate on a step means that each member of some
-- quorum of the source committee endorsed the step. Two quorums of one
-- committee share an honest member (honest-meet). An honest member endorses
-- only a real step (faithful) and at most one successor of a state (single).
-- Descent is a chain of certified steps (O57), so signature checks alone
-- give Legit and Core. Two tips are in the descent order, one before the other
-- (O3, O66: tip-order). The proof is by induction on the length of one chain:
-- no-fork joins its last step to the first step of the other chain.
module Authority (Artifact : Type) (Ballot : Type) (Agenda : Type) (Edit : Type) (Member : Type) (Committee : Type) (Quorum : Committee → Type) (_∈_ : (c : Committee) → Member → Quorum c → Type) (Circuit : Type → Type → Type) (run : (A : Type) → (B : Type) → Circuit A B → A → B) (State : Type) (isSetState : isSet State) (height : State → ℕ) (artifact : State → Artifact) (committee : State → Committee) (constitution : State → Agenda → Circuit (FMSet Ballot) (Maybe Edit)) (apply : Edit → State → State) (advance : (e : Edit) → (σ : State) → height (apply e σ) ≡ suc (height σ)) (genesis : State) (Core : State → Type) (isPropCore : (σ : State) → isProp (Core σ)) (core₀ : Core genesis) (Honest : Member → Type) (Endorses : Member → State → State → Type) (honest-meet : (c : Committee) → (q : Quorum c) → (r : Quorum c) → ∃[ i ꞉ Member ] _∈_ c i q × _∈_ c i r × Honest i) (faithful : (i : Member) → (σ : State) → (τ : State) → Honest i → Endorses i σ τ → ∥ StepD Artifact Ballot Agenda Edit Member Committee Quorum _∈_ Circuit run State isSetState height artifact committee constitution apply advance genesis Core isPropCore core₀ σ τ ∥₁) (single : (i : Member) → (σ : State) → (a : State) → (b : State) → Honest i → Endorses i σ a → Endorses i σ b → a ≡ b) where
  StepA : State → State → Type
  StepA σ τ = StepD Artifact Ballot Agenda Edit Member Committee Quorum _∈_ Circuit run State isSetState height artifact committee constitution apply advance genesis Core isPropCore core₀ σ τ
  ReachA : State → Type
  ReachA σ = Reach Artifact Ballot Agenda Edit Member Committee Quorum _∈_ Circuit run State isSetState height artifact committee constitution apply advance genesis Core isPropCore core₀ σ
  LegitA : State → Type
  LegitA σ = Legit Artifact Ballot Agenda Edit Member Committee Quorum _∈_ Circuit run State isSetState height artifact committee constitution apply advance genesis Core isPropCore core₀ σ
  rootA : ReachA genesis
  rootA = root Artifact Ballot Agenda Edit Member Committee Quorum _∈_ Circuit run State isSetState height artifact committee constitution apply advance genesis Core isPropCore core₀
  snocA : (σ : State) → (τ : State) → ReachA σ → StepA σ τ → ReachA τ
  snocA = _▸_ Artifact Ballot Agenda Edit Member Committee Quorum _∈_ Circuit run State isSetState height artifact committee constitution apply advance genesis Core isPropCore core₀
  legit-coreA : (σ : State) → LegitA σ → Core σ
  legit-coreA = legit-core Artifact Ballot Agenda Edit Member Committee Quorum _∈_ Circuit run State isSetState height artifact committee constitution apply advance genesis Core isPropCore core₀
  Cert : (σ : State) → State → Quorum (committee σ) → Type
  Cert σ τ q = (i : Member) → _∈_ (committee σ) i q → Endorses i σ τ
  Signed : State → State → Type
  Signed σ τ = Σ (Quorum (committee σ)) (λ q → Cert σ τ q)
  Authorized : State → State → Type
  Authorized σ τ = ∃[ q ꞉ Quorum (committee σ) ] Cert σ τ q
  Meet : (c : Committee) → Quorum c → Quorum c → Type
  Meet c q r = Σ Member (λ i → _∈_ c i q × _∈_ c i r × Honest i)
  HonestIn : (c : Committee) → Quorum c → Type
  HonestIn c q = Σ Member (λ i → _∈_ c i q × Honest i)
  honest-pick : (c : Committee) → (q : Quorum c) → Meet c q q → HonestIn c q
  honest-pick c q w = fst w , fst (snd w) , snd (snd (snd w))
  law honest-in : (c : Committee) → (q : Quorum c) → ∃[ i ꞉ Member ] _∈_ c i q × Honest i
  honest-in c q = rec₁ (Meet c q q) (∃[ i ꞉ Member ] _∈_ c i q × Honest i) (squash (HonestIn c q)) (λ (w : Meet c q q) → ∣_∣₁ (HonestIn c q) (honest-pick c q w)) (honest-meet c q q)
  sound-q : (σ : State) → (τ : State) → (u : Signed σ τ) → HonestIn (committee σ) (fst u) → ∥ StepA σ τ ∥₁
  sound-q σ τ u g = faithful (fst g) σ τ (snd (snd g)) (snd u (fst g) (fst (snd g)))
  sound-s : (σ : State) → (τ : State) → Signed σ τ → ∥ StepA σ τ ∥₁
  sound-s σ τ u = rec₁ (HonestIn (committee σ) (fst u)) ∥ StepA σ τ ∥₁ (squash (StepA σ τ)) (sound-q σ τ u) (honest-in (committee σ) (fst u))
  law sound : (σ : State) → (τ : State) → Authorized σ τ → ∥ StepA σ τ ∥₁
  sound σ τ = rec₁ (Signed σ τ) ∥ StepA σ τ ∥₁ (squash (StepA σ τ)) (sound-s σ τ)
  fork-meet : (σ : State) → (a : State) → (b : State) → (u : Signed σ a) → (v : Signed σ b) → Meet (committee σ) (fst u) (fst v) → a ≡ b
  fork-meet σ a b u v w = single (fst w) σ a b (snd (snd (snd w))) (snd u (fst w) (fst (snd w))) (snd v (fst w) (fst (snd (snd w))))
  fork-v : (σ : State) → (a : State) → (b : State) → (u : Signed σ a) → Signed σ b → a ≡ b
