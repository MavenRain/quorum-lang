-- The closed toy instance (O65). State is ℕ, each step adds 1, and Core is
-- 0 ≡ 0. The four obligations are isSetℕ ℕ, refl, isSetℕ ℕ 0 0 and refl. Then
-- legit-core and reach-core take the 22 toy arguments.
toyQuorum : Bool → Type
toyQuorum c = Bool

toyIn : (c : Bool) → Bool → Bool → Type
toyIn c i q = i ≡ i

toyCircuit : Type → Type → Type
toyCircuit A B = A → B

toyRun : (A : Type) → (B : Type) → (A → B) → A → B
toyRun A B f = f

toyHeight : ℕ → ℕ
toyHeight n = n

toyArtifact : ℕ → ℕ
toyArtifact n = n

toyCommittee : ℕ → Bool
toyCommittee n = true

toyConstitution : ℕ → Bool → FMSet Bool → Maybe Bool
toyConstitution σ a b = just true

toyApply : Bool → ℕ → ℕ
toyApply e σ = suc σ

toyAdvance : (e : Bool) → (σ : ℕ) → toyHeight (toyApply e σ) ≡ suc (toyHeight σ)
toyAdvance e σ = refl

toyCore : ℕ → Type
toyCore σ = 0 ≡ 0

toyIsPropCore : (σ : ℕ) → isProp (toyCore σ)
toyIsPropCore σ = isSetℕ ℕ 0 0

toyCore₀ : toyCore 0
toyCore₀ = refl

