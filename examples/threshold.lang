  law certified-legit : (σ : State) → _⊑_ genesis σ → LegitA σ
  certified-legit σ c = desc-legit (fst c) σ (snd c)
  law certified-core : (σ : State) → _⊑_ genesis σ → Core σ
  certified-core σ c = legit-coreA σ (certified-legit σ c)
  Tip : Type
  Tip = Σ State (λ σ → _⊑_ genesis σ)
  ReplicaA : Type₁
  ReplicaA = Replica State genesis _⊑_
  current : (R : ReplicaA) → Rep State genesis _⊑_ R → Artifact
  current R r = artifact (fst (denote State genesis _⊑_ R r))
  Agree : (R : ReplicaA) → Rep State genesis _⊑_ R → Rep State genesis _⊑_ R → Type
  Agree R r s = fst (denote State genesis _⊑_ R r) ≡ fst (denote State genesis _⊑_ R s)
  Ordered : State → State → Type
  Ordered σ τ = Σ Bool (λ b → elim (λ (x : Bool) → Type) (_⊑_ τ σ) (_⊑_ σ τ) b)
  auth-from : (ρ : State) → (μ : State) → (σ : State) → ρ ≡ μ → Authorized μ σ → Authorized ρ σ
  auth-from ρ μ σ p a = primTransp (λ i → Authorized (p (~ i)) σ) i0 a
  desc-cons : (ρ : State) → (σ : State) → (j : ℕ) → (μ : State) → Σ State (λ ν → Authorized ρ ν × Desc ν j μ) → Authorized μ σ → Σ State (λ ν → Authorized ρ ν × Desc ν (suc j) σ)
  desc-cons ρ σ j μ w a = fst w , fst (snd w) , μ , snd (snd w) , a
  desc-uncons : (k : ℕ) → (ρ : State) → (σ : State) → Desc ρ (suc k) σ → Σ State (λ ν → Authorized ρ ν × Desc ν k σ)
