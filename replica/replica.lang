-- The replica program of S8 (O104). H2b gives the smoke entries of the
-- host import q_hash2 (O105). H3 adds the certificate chain. The program
-- has host imports, so the node runner cannot run it: build/replicatool
-- (test/replicatool.c) is its host. H4 adds the merge and H5a the FHE
-- tally route.
hashOf : ℕ → W4
hashOf x = q_hash2 (w4 x x x x) (w4 x x x x)
hash0 : ℕ → ℕ
hash0 x = w4a (hashOf x)
hash1 : ℕ → ℕ
hash1 x = w4b (hashOf x)
hash2 : ℕ → ℕ
hash2 x = w4c (hashOf x)
hash3 : ℕ → ℕ
hash3 x = w4d (hashOf x)
-- H2b part B (O109 (i)): the input entries over a Stack that the host
-- writes below heap_base. chainOf hashes the last item first.
total : Stack → ℕ
total s = fold 0 (λ (top : ℕ) (acc : ℕ) → natAdd top acc) s
chainOf : Stack → W4
chainOf s = fold (w4 0 0 0 0) (λ (x : ℕ) (acc : W4) → q_hash2 (w4 x x x x) acc) s
chain0 : Stack → ℕ
chain0 s = w4a (chainOf s)
chain1 : Stack → ℕ
chain1 s = w4b (chainOf s)
chain2 : Stack → ℕ
chain2 s = w4c (chainOf s)
chain3 : Stack → ℕ
chain3 s = w4d (chainOf s)
-- H3 (O107): the certificate chain. A step appends its body to the head,
-- and the group signs the new head with FROST (q_frost_verify, R-C1). The
-- walk keeps the first failure: 1 for a bad signature, 2 for a bad step
-- number (R-C5). The public key is 8 ℕ entry parameters, word 0 the most
-- significant (R-C6).
tagGenesis : W4
tagGenesis = w4 8175563235948047719 7308890791633682432 0 0
tagAppend : W4
tagAppend = w4 8175563235948047713 8102087254438051840 0 0
zero4 : W4
zero4 = w4 0 0 0 0
