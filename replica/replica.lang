partsCode s ps = fold 0 (λ (d : DecPart) (g : W8) (acc : ℕ) → flagIf (natEq acc 0) (flagIf (natEq (q_partial_verify d g s) 0) 0 8) acc) ps
routeCode : W8 → Ballots → Parts → W16 → ℕ
routeCode pk bs ps s = (λ (c : ℕ) → flagIf (natEq c 0) (partsCode s ps) c) (ballotCode pk bs)
