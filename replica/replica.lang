openOf ps ks s = q_combine ps (fold 0 (λ (d : DecPart) (g : W8) (acc : ℕ) → natAdd acc 1) ps) ks 2 (fold 0 (λ (g : W8) (acc : ℕ) → natAdd acc 1) ks) s 8
ballot_verify : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Ballots → Parts → KeyList → ℕ
ballot_verify x0 x1 x2 x3 y0 y1 y2 y3 b p k = ballotCode (w8 x0 x1 x2 x3 y0 y1 y2 y3) b
tally_sum : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Ballots → Parts → KeyList → ℕ
tally_sum x0 x1 x2 x3 y0 y1 y2 y3 b p k = w16a (sumOf b)
partial_verify : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Ballots → Parts → KeyList → ℕ
partial_verify x0 x1 x2 x3 y0 y1 y2 y3 b p k = routeCode (w8 x0 x1 x2 x3 y0 y1 y2 y3) b p (sumOf b)
combine : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Ballots → Parts → KeyList → ℕ
combine x0 x1 x2 x3 y0 y1 y2 y3 b p k = (λ (s : W16) → flagIf (natEq (routeCode (w8 x0 x1 x2 x3 y0 y1 y2 y3) b p s) 0) ((λ (o : W4) → flagIf (natEq (w4b o) 0) (w4a o) 0) (openOf p k s)) 0) (sumOf b)
-- H5b (R-E14 to R-E20): the amend check of a new constitution, a Stack of
