sigOf r z = w12 (w8a r) (w8b r) (w8c r) (w8d r) (w8e r) (w8f r) (w8g r) (w8h r) (w4a z) (w4b z) (w4c z) (w4d z)
appendHead : W4 → W4 → W4
appendHead h b = q_hash2 (q_hash2 tagAppend h) (q_hash2 b zero4)
stepCode : W8 → W4 → W8 → W4 → ℕ → ℕ → W4 → ℕ
stepCode pk b r z code n h = flagIf (natEq code 0) (flagIf (natEq (w4a b) n) (flagIf (natEq (q_frost_verify pk (sigOf r z) h) 0) 0 1) 2) code
stepOf : W8 → W4 → W8 → W4 → Link → Link
stepOf pk b r z acc = (λ (h : W4) → link (stepCode pk b r z (linkCode acc) (natAdd (linkCount acc) 1) h) (natAdd (linkCount acc) 1) h) (appendHead (linkHead acc) b)
walk : W8 → CertChain → Link
walk pk c = fold (link 0 0 (q_hash2 tagGenesis zero4)) (λ (b : W4) (r : W8) (z : W4) (acc : Link) → stepOf pk b r z acc) c
cert_verify : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → CertChain → ℕ
cert_verify x0 x1 x2 x3 y0 y1 y2 y3 c = linkCode (walk (w8 x0 x1 x2 x3 y0 y1 y2 y3) c)
rep_tip : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → CertChain → ℕ
rep_tip x0 x1 x2 x3 y0 y1 y2 y3 c = (λ (k : Link) → flagIf (natEq (linkCode k) 0) (linkCount k) 0) (walk (w8 x0 x1 x2 x3 y0 y1 y2 y3) c)
-- H4 (O108, R-D1 to R-D5): the merge of two chains. The code is the first
-- failure of a, then of b. Then the heads of a and b at the shorter count
-- must be equal (b fast-forwards a), else 3 (REP_FORK). The merged tip is
-- the longer count. sameAt hashes only: walk checked each signature.
sameW4 : W4 → W4 → ℕ
sameW4 a b = flagIf (natEq (w4a a) (w4a b)) (flagIf (natEq (w4b a) (w4b b)) (flagIf (natEq (w4c a) (w4c b)) (flagIf (natEq (w4d a) (w4d b)) 1 0) 0) 0) 0
twinStep : W4 → ℕ → W4 → Twin → Twin
twinStep b m h acc = (λ (g : W4) → twinOf (natAdd (twinCount acc) 1) g (flagIf (natEq (natAdd (twinCount acc) 1) m) (sameW4 g h) (twinSame acc))) (appendHead (twinHead acc) b)
sameAt : ℕ → W4 → CertChain → ℕ
sameAt m h c = twinSame (fold (twinOf 0 (q_hash2 tagGenesis zero4) 1) (λ (b : W4) (r : W8) (z : W4) (acc : Twin) → twinStep b m h acc) c)
mergeCode : Link → Link → CertChain → CertChain → ℕ
mergeCode ka kb a b = flagIf (natEq (linkCode ka) 0) (flagIf (natEq (linkCode kb) 0) (flagIf (natEq (flagIf (natLe (linkCount ka) (linkCount kb)) (sameAt (linkCount ka) (linkHead ka) b) (sameAt (linkCount kb) (linkHead kb) a)) 1) 0 3) (linkCode kb)) (linkCode ka)
